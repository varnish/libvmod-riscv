client c0 {
	txreq -url "/pooled"
	rxresp
	expect resp.http.X-Pooled >= 20
} -run

# The pool shrinks back to thread_pool_min once its threads have been
# idle for thread_pool_timeout, and their VMs go with them.
delay 25

client c0 {
	txreq -url "/pooled"
	rxresp
	expect resp.http.X-Pooled <= 10
} -run
