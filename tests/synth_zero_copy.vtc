varnishtest "RISC-V synth bodies in fork-owned memory are used in place"

feature cmd "varnishd -V 2>&1 | grep -q varnish-plus"

shell {
cat >${tmpdir}/${testname}.cpp <<-EOF
#include "riscv_api.hpp"

static void on_recv(int req)
{
	decision("synth", 5, 200);
}

static const char mime[] = "text/plain";
static char guard[16] = "0123456789ABCDE";
static char small[32] = "-";
static char large[20001] = "-";
__attribute__((aligned(4096))) static char pageend[8192] = "-";

void on_synth()
{
	char url[256];
	get_url(0, url, sizeof(url)-1);

	if (strcmp(url, "/small") == 0) {
		const char text[] = "small heap body";
		for (unsigned i = 0; i < sizeof(text); i++)
			small[i] = text[i];
		synth(200, mime, sizeof(mime)-1, small, sizeof(text)-1);
	} else if (strcmp(url, "/large") == 0) {
		for (int i = 0; i < 20000; i++)
			large[i] = 'a' + i % 10;
		large[20000] = 0;
		synth(200, mime, sizeof(mime)-1, large, 20000);
	} else if (strcmp(url, "/pageend") == 0) {
		for (int i = 0; i < 4096; i++)
			pageend[i] = 'z';
		pageend[4096] = 0;
		synth(200, mime, sizeof(mime)-1, &pageend[4096 - 100], 100);
	} else if (strcmp(url, "/guard") == 0) {
		guard[0] = '0';
		synth(200, mime, sizeof(mime)-1, guard, 10);
	} else if (strcmp(url, "/check") == 0) {
		synth(200, mime, sizeof(mime)-1, guard, sizeof(guard)-1);
	}
}

void start(int argc, char** argv) {
	register_callback(3, (void(*)())on_synth);
	wait_for_requests(on_recv);
}
EOF
bash ${testdir}/build.sh ${tmpdir}/${testname}.cpp ${testdir} ${tmpdir}/${testname}
}

varnish v1 -vcl {
	vcl 4.1;
	import riscv;

	backend default none;

	sub vcl_init {
		riscv.embed_tenants("""{
			"xpizza.com": {
				"filename": "${tmpdir}/${testname}",
				"group": "test"
			}
		}""");
		riscv.finalize_tenants();
	}

	sub vcl_recv {
		if (!riscv.fork(req.http.Host)) {
			return (synth(403));
		}
		if (req.restarts > 0) {
			set req.url = "/check";
		}
		riscv.vcall(ON_REQUEST);
		return (synth(riscv.want_status()));
	}

	sub vcl_synth {
		if (riscv.active()) {
			riscv.vcall(ON_SYNTH);
			if (req.http.X-Restart && req.restarts == 0) {
				return (restart);
			}
			return (deliver);
		}
	}
} -start

client c1 {
	txreq -url "/small" -hdr "Host: xpizza.com"
	rxresp
	expect resp.status == 200
	expect resp.body == "small heap body"

	txreq -url "/large" -hdr "Host: xpizza.com"
	rxresp
	expect resp.status == 200
	expect resp.bodylen == 20000
	expect resp.body ~ "^(?:abcdefghij)++$"

	txreq -url "/pageend" -hdr "Host: xpizza.com"
	rxresp
	expect resp.status == 200
	expect resp.bodylen == 100
	expect resp.body ~ "^z{100}$"

	txreq -url "/guard" -hdr "Host: xpizza.com"
	rxresp
	expect resp.status == 200
	expect resp.body == "0123456789"

	txreq -url "/guard" -hdr "Host: xpizza.com" -hdr "X-Restart: 1"
	rxresp
	expect resp.status == 200
	expect resp.body == "0123456789ABCDE"
} -run
