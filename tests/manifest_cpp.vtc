varnishtest "RISC-V per-viewer HLS and DASH manifests with per-URL signed tokens"

feature cmd "varnishd -V 2>&1 | grep -q varnish-plus"
feature cmd "ls /usr/bin/riscv64-linux-gnu-g++* >/dev/null 2>&1"
feature cmd "command -v curl >/dev/null && command -v openssl >/dev/null"

shell {printf '\357\273\277#EXTM3U\n  \n\t\nseg1.ts \n#EXT-X-SESSION-DATA:DATA-ID="x",X-URI="a.json",VALUE="b,URI=c",URI="data.json"\n#EXT-X-DATERANGE:ID="ad",X-ASSET-URI="ad.m3u8"\n' > ${tmpdir}/bom.m3u8}

server s1 {
	rxreq
	expect req.url == "/live/ch1/master.m3u8"
	expect req.http.X-Token == <undef>
	txresp -gzipbody "#EXTM3U\n#EXT-X-VERSION:6\n#EXT-X-MEDIA:TYPE=AUDIO,GROUP-ID=\"aud\",NAME=\"en\",URI=\"audio/en.m3u8\"\n#EXT-X-STREAM-INF:BANDWIDTH=800000,AUDIO=\"aud\"\nlow/index.m3u8\n#EXT-X-STREAM-INF:BANDWIDTH=3000000,AUDIO=\"aud\"\r\nhttps://cdn.example.com/live/ch1/high/index.m3u8?v=2\r\n"

	rxreq
	expect req.url == "/live/ch1/low/index.m3u8"
	txresp -hdr "Content-Type: application/vnd.apple.mpegurl" -body "#EXTM3U\n#EXT-X-TARGETDURATION:6\n#EXT-X-MEDIA-SEQUENCE:100\n#EXT-X-KEY:METHOD=SAMPLE-AES,URI=\"skd://key-42\",KEYFORMAT=\"com.apple.streamingkeydelivery\"\n#EXT-X-MAP:URI=\"init.mp4\"\n#EXT-X-RENDITION-REPORT:URI=\"../high/index.m3u8\",LAST-MSN=101\n#EXT-X-PRELOAD-HINT:TYPE=PART,URI=\"?_HLS_part=3\"\n#EXTINF:6.0,\nseg100.ts\n#EXTINF:6.0,\nseg101.ts#t=1\n"

	rxreq
	expect req.url == "/vod/movie/manifest.mpd"
	txresp -hdr "Content-Type: application/dash+xml" -body {<?xml version="1.0"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static">
  <Location>https://cdn.example.com/vod/movie/manifest.mpd</Location>
  <BaseURL>https://cdn.example.com/vod/movie/</BaseURL>
  <BaseURL>https://backup.example.com/vod/movie/</BaseURL>
  <BaseURL>https://mirror.example.com/other/movie/</BaseURL>
  <!-- <BaseURL>commented.mp4</BaseURL> -->
  <Period>
    <AdaptationSet mimeType="video/mp4">
      <SegmentTemplate timescale="90000" media="video/seg_$Number$.m4s" initialization='video/init.m4s' startNumber="1"/>
      <Representation id="v1" bandwidth="500000"/>
    </AdaptationSet>
    <AdaptationSet mimeType="audio/mp4">
      <BaseURL>../shared/</BaseURL>
      <Representation id="a1" bandwidth="64000">
        <SegmentList>
          <Initialization sourceURL="audio/init.mp4"/>
          <SegmentURL media="audio/1.m4s?v=3"/>
        </SegmentList>
      </Representation>
    </AdaptationSet>
    <AdaptationSet mimeType="text/vtt">
      <Representation id="t1" bandwidth="256">
        <BaseURL> subs/en.vtt </BaseURL>
      </Representation>
    </AdaptationSet>
  </Period>
</MPD>
}

	rxreq
	expect req.url == "/live/ch1/bom.m3u8"
	txresp -bodyfrom ${tmpdir}/bom.m3u8

	rxreq
	expect req.url == "/vod/live.mpd"
	txresp -body {<MPD xmlns:xlink="http://www.w3.org/1999/xlink">
<PatchLocation ttl="60">patch.mpp</PatchLocation>
<ContentSteering defaultServiceLocation="a">steering.dcsm</ContentSteering>
<Period xlink:href="period2.xml" xlink:actuate="onLoad"/>
<Period id="p3" xlink:href="urn:mpeg:dash:resolve-to-zero:2013"/>
<AdaptationSet bitstreamSwitching="true"><SegmentList><BitstreamSwitching sourceURL="bs.mp4"/></SegmentList></AdaptationSet>
</MPD>
}

	rxreq
	expect req.url == "/live/ch1/low/seg100.ts"
	txresp -body "segment-100"
} -start

server s2 -repeat 8 {
	rxreq
	txresp -body "#EXTM3U\nseg.ts\n"
} -start

varnish v1 -vcl+backend {
	vcl 4.1;
	import riscv;

	sub vcl_init {
		riscv.embed_tenants("""{
			"streaming": {
				"filename": "${testdir}/../program/cpp/manifest.cpp",
				"arguments": ["test-secret", "600"],
				"group": "test"
			},
			"long": {
				"filename": "${testdir}/../program/cpp/manifest.cpp",
				"arguments": ["test-secret", "10000000000000"],
				"group": "test"
			}
		}""");
		riscv.finalize_tenants();
	}

	sub vcl_recv {
		if (req.url ~ "^/(long/|live/ch1/high/|vod/shared/|vod/movie/(video|subs)/)") {
			set req.backend_hint = s2;
		}
		if (req.url ~ "^/long/") {
			if (!riscv.fork("long")) {
				return (synth(503));
			}
		} else if (!riscv.fork("streaming")) {
			return (synth(503));
		}
		if (req.http.X-Call) {
			set req.http.X-Result = riscv.call(req.http.X-Call, req.url);
		}
		set req.http.X-Token = riscv.call("authorize", req.url);
		if (req.http.X-Token !~ "^[A-Za-z0-9_.-]+$") {
			return (synth(403));
		}
		set req.url = regsuball(req.url, "(?<=[?&])token=[^&#]*&?", "");
		set req.url = regsub(req.url, "[?&]$", "");
		return (hash);
	}

	sub vcl_backend_fetch {
		unset bereq.http.X-Token;
	}

	sub vcl_backend_response {
		if (bereq.url ~ "(?i)\.(m3u8|mpd)(\?|$)") {
			set beresp.do_gunzip = true;
		}
	}

	sub vcl_deliver {
		if (req.url ~ "(?i)\.(m3u8|mpd)(\?|$)" && resp.status == 200) {
			if (!req.http.X-Transform) {
				set req.http.X-Transform = "personalize";
			}
			if (!req.http.X-Arg) {
				set req.http.X-Arg = req.http.X-Token;
			}
			if (!riscv.deliver_transform(req.http.X-Transform, req.http.X-Arg)) {
				return (synth(503));
			}
			set resp.http.Cache-Control = "private, no-store";
			set resp.http.X-Viewer-ID = regsub(req.http.X-Token, "\..*$", "");
		}
	}
} -start

client c1 {
	txreq -url "/live/ch1/master.m3u8" -hdr "Accept-Encoding: gzip"
	rxresp
	expect resp.status == 200
	expect resp.http.Content-Encoding == <undef>
	expect resp.http.Cache-Control == "private, no-store"
	expect resp.http.X-Viewer-ID ~ "^[A-Za-z0-9_-]{16}$"
	expect resp.body ~ "^#EXTM3U\n#EXT-X-VERSION:6\n#EXT-X-MEDIA:TYPE=AUDIO,GROUP-ID=\"aud\",NAME=\"en\",URI=\"audio/en\\.m3u8\\?token=[A-Za-z0-9_-]{16}\\.[0-9]+\\.[A-Za-z0-9_-]{22}\"\n#EXT-X-SESSION-DATA:DATA-ID=\"com\\.varnish\\.viewer-id\",VALUE=\"[A-Za-z0-9_-]{16}\"\n#EXT-X-STREAM-INF:BANDWIDTH=800000,AUDIO=\"aud\"\nlow/index\\.m3u8\\?token=[^\n]+\n#EXT-X-STREAM-INF:BANDWIDTH=3000000,AUDIO=\"aud\"\r\nhttps://cdn\\.example\\.com/live/ch1/high/index\\.m3u8\\?v=2&token=[^\r]+\r\n$"

	txreq -url "/live/ch1/low/index.m3u8"
	rxresp
	expect resp.status == 200
	expect resp.http.Content-Type == "application/vnd.apple.mpegurl"
	expect resp.body ~ "URI=\"skd://key-42\",KEYFORMAT"
	expect resp.body ~ "#EXT-X-MAP:URI=\"init\\.mp4\\?token=[^\"]+\"\n"
	expect resp.body ~ "#EXT-X-RENDITION-REPORT:URI=\"\\.\\./high/index\\.m3u8\\?token=[A-Za-z0-9_.-]+\",LAST-MSN=101\n"
	expect resp.body ~ "#EXT-X-PRELOAD-HINT:TYPE=PART,URI=\"\\?_HLS_part=3&token=[A-Za-z0-9_.-]+\"\n"
	expect resp.body ~ "\nseg100\\.ts\\?token=[A-Za-z0-9_.-]+\n"
	expect resp.body ~ "\nseg101\\.ts\\?token=[A-Za-z0-9_.-]+#t=1\n$"
	expect resp.body !~ "SESSION-DATA"

	txreq -url "/vod/movie/manifest.mpd"
	rxresp
	expect resp.status == 200
	expect resp.http.Content-Type == "application/dash+xml"
	expect resp.body ~ "<Location>https://cdn\\.example\\.com/vod/movie/manifest\\.mpd\\?token=[^<]+</Location>"
	expect resp.body ~ "<BaseURL>https://cdn\\.example\\.com/vod/movie/</BaseURL>\n  <BaseURL>https://backup\\.example\\.com/vod/movie/</BaseURL>\n  <!-- "
	expect resp.body !~ "mirror"
	expect resp.body ~ "<!-- <BaseURL>commented\\.mp4</BaseURL> -->"
	expect resp.body ~ "media=\"video/seg_\\$Number\\$\\.m4s\\?token=[A-Za-z0-9_-]{16}\\.[0-9]+\\.21\\.4\\.[A-Za-z0-9_-]{22}\" initialization='video/init\\.m4s\\?token=[A-Za-z0-9_-]{16}\\.[0-9]+\\.[A-Za-z0-9_-]{22}' startNumber=\"1\"/>"
	expect resp.body ~ "<BaseURL>\\.\\./shared/</BaseURL>"
	expect resp.body ~ "<Initialization sourceURL=\"audio/init\\.mp4\\?token=[^\"]+\"/>"
	expect resp.body ~ "<SegmentURL media=\"audio/1\\.m4s\\?v=3&amp;token=[^\"]+\"/>"
	expect resp.body ~ "<BaseURL> subs/en\\.vtt\\?token=[A-Za-z0-9_.-]+ </BaseURL>"
	expect resp.body ~ "token=[A-Za-z0-9_-]{16}\\.[0-9]+\\.[A-Za-z0-9_-]{22}\"/>"

	txreq -url "/live/ch1/bom.m3u8"
	rxresp
	expect resp.status == 200
	expect resp.body ~ "^\\xEF\\xBB\\xBF#EXTM3U\n  \n\\t\nseg1\\.ts\\?token=[A-Za-z0-9_.-]+ \n"
	expect resp.body ~ "DATA-ID=\"x\",X-URI=\"a\\.json\",VALUE=\"b,URI=c\",URI=\"data\\.json\\?token=[A-Za-z0-9_.-]+\"\n"
	expect resp.body ~ "X-ASSET-URI=\"ad\\.m3u8\"\n$"

	txreq -url "/vod/live.mpd"
	rxresp
	expect resp.status == 200
	expect resp.body ~ "<PatchLocation ttl=\"60\">patch\\.mpp\\?token=[A-Za-z0-9_.-]+</PatchLocation>"
	expect resp.body ~ "<ContentSteering defaultServiceLocation=\"a\">steering\\.dcsm\\?token=[A-Za-z0-9_.-]+</ContentSteering>"
	expect resp.body ~ "<Period xlink:href=\"period2\\.xml\\?token=[A-Za-z0-9_.-]+\" xlink:actuate=\"onLoad\"/>"
	expect resp.body ~ "xlink:href=\"urn:mpeg:dash:resolve-to-zero:2013\"/>"
	expect resp.body ~ "<AdaptationSet bitstreamSwitching=\"true\"><SegmentList><BitstreamSwitching sourceURL=\"bs\\.mp4\\?token=[A-Za-z0-9_.-]+\"/>"

	# Function used as a transform
	txreq -url "/live/ch1/master.m3u8" -hdr "X-Transform: authorize"
	rxresp
	expect resp.status == 503

	# Transform called as a function
	txreq -url "/live/ch1/master.m3u8" -hdr "X-Call: personalize"
	rxresp
	expect resp.status == 503
} -run

shell -exit 0 -expect "flow ok" {
	set -ex
	base=http://${v1_addr}:${v1_port}
	get() { curl -s --path-as-is -H "Host: ${localhost}" "$@"; }
	code() { get -o /dev/null -w '%{http_code}' "$@"; }
	field() { echo "$1" | cut -d. -f"$2"; }
	mac() {
		printf '%s\n%s' "$1" "$2" | openssl dgst -sha256 -hmac test-secret -binary \
			| head -c 16 | base64 | tr '+/' '-_' | tr -d '='
	}

	get -f -D ${tmpdir}/h1 -o ${tmpdir}/master1 "$base/live/ch1/master.m3u8"
	token=$(sed -n 's/^low\/index\.m3u8?token=//p' ${tmpdir}/master1)
	viewer=$(field "$token" 1)
	grep -qi "^X-Viewer-ID: $viewer" ${tmpdir}/h1
	grep -q "VALUE=\"$viewer\"" ${tmpdir}/master1

	get -f -o ${tmpdir}/master2 "$base/live/ch1/master.m3u8"
	token2=$(sed -n 's/^low\/index\.m3u8?token=//p' ${tmpdir}/master2)
	test "$(field "$token2" 1)" != "$viewer"

	get -f -o ${tmpdir}/variant "$base/live/ch1/low/index.m3u8?token=$token"
	seg=$(sed -n 's/^seg100\.ts?token=//p' ${tmpdir}/variant)
	test "$(field "$seg" 1)" = "$viewer"
	test "$(get -f "$base/live/ch1/low/seg100.ts?token=$seg")" = "segment-100"

	exp=$(field "$seg" 2)
	sig=$(field "$seg" 3)
	test $(code "$base/live/ch1/low/seg100.ts") = 403
	test $(code "$base/live/ch1/low/seg100.ts?token=x$seg") = 403
	# Extended expiry
	test $(code "$base/live/ch1/low/seg100.ts?token=$viewer.$((exp + 1)).$sig") = 403
	# Session without a signature
	test $(code "$base/live/ch1/low/seg100.ts?token=$viewer.$exp") = 403
	# Exact signature as a template token
	test $(code "$base/live/ch1/low/seg100.ts?token=$viewer.$exp.0.0.$sig") = 403
	# Other segment, rendition, channel, and manifest
	test $(code "$base/live/ch1/low/seg101.ts?token=$seg") = 403
	test $(code "$base/live/ch1/high/seg100.ts?token=$seg") = 403
	test $(code "$base/live/ch2/low/seg100.ts?token=$seg") = 403
	test $(code "$base/live/ch1/master.m3u8?token=$token") = 403
	# Dot segments and escapes
	test $(code "$base/live/ch1/low/../low/seg100.ts?token=$seg") = 403
	test $(code "$base/live/ch1/low/%73eg100.ts?token=$seg") = 403

	now=$(date +%s)
	past="$viewer.$((now - 1))"
	test $(code "$base/live/ch1/low/seg100.ts?token=$past.$(mac "$past" /live/ch1/low/seg100.ts)") = 403
	good="$viewer.$((now + 60))"
	test $(code "$base/live/ch1/low/seg100.ts?token=$good.$(mac "$good" /live/ch1/low/seg100.ts)") = 200

	high=$(sed -n 's/^https:\/\/cdn\.example\.com\/live\/ch1\/high\/index\.m3u8?v=2&token=//p' ${tmpdir}/master1 | tr -d '\r')
	test $(code "$base/live/ch1/high/index.m3u8?v=2&token=$high") = 200
	report=$(sed -n 's/.*URI="\.\.\/high\/index\.m3u8?token=\([^"]*\)".*/\1/p' ${tmpdir}/variant)
	test $(code "$base/live/ch1/high/index.m3u8?token=$report") = 200
	hint=$(sed -n 's/.*URI="?_HLS_part=3&token=\([^"]*\)".*/\1/p' ${tmpdir}/variant)
	test $(code "$base/live/ch1/low/index.m3u8?token=$hint") = 200

	# Transform argument that is not a token for the manifest
	test $(code -H "X-Arg: $seg" "$base/live/ch1/low/index.m3u8?token=$token") = 403
	test $(code -H "X-Arg: $high" "$base/live/ch1/low/index.m3u8?token=$token") = 403
	test $(code -H "X-Arg: $viewer.$((now + 60))" "$base/live/ch1/low/index.m3u8?token=$token") = 403
	test $(code -H "X-Arg: $token" "$base/live/ch1/low/index.m3u8?token=$token") = 200

	get -f -o ${tmpdir}/mpd "$base/vod/movie/manifest.mpd"
	media=$(grep -o 'seg_[$]Number[$][.]m4s?token=[^"]*' ${tmpdir}/mpd | cut -d= -f2)
	viewer=$(field "$media" 1)
	exp=$(field "$media" 2)
	sig=$(field "$media" 5)
	test $(code "$base/vod/movie/video/seg_7.m4s?token=$media") = 200
	test $(code "$base/vod/movie/video/seg_12.m4s?token=$media") = 200
	# Outside the template prefix or suffix
	test $(code "$base/vod/movie/video/init.m4s?token=$media") = 403
	test $(code "$base/vod/movie/video/seg_7.mp4?token=$media") = 403
	test $(code "$base/vod/other/video/seg_7.m4s?token=$media") = 403
	# Widened template prefix
	test $(code "$base/vod/movie/video/seg_7.m4s?token=$viewer.$exp.17.4.$sig") = 403
	test $(code "$base/vod/movie/video/seg_7.m4s?token=$viewer.$exp.$sig") = 403
	tmpl="$viewer.$((now + 60)).21.4"
	test $(code "$base/vod/movie/video/seg_7.m4s?token=$tmpl.$(mac "$tmpl" /vod/movie/video/seg_.m4s)") = 200
	tmpl="$viewer.$((now + 60)).11.0"
	test $(code "$base/vod/movie/video/seg_7.m4s?token=$tmpl.$(mac "$tmpl" /vod/movie//)") = 200
	# Template token on a manifest, deeper path
	test $(code "$base/vod/movie/manifest.mpd?token=$tmpl.$(mac "$tmpl" /vod/movie/)") = 403
	test $(code "$base/vod/movie/video/seg_7.m4s?token=$tmpl.$(mac "$tmpl" /vod/movie/)") = 403
	test $(code "$base/vod/movie/video/a/seg_7.m4s?token=$tmpl.$(mac "$tmpl" /vod/movie//)") = 403

	init=$(grep -o 'audio/init[.]mp4?token=[^"]*' ${tmpdir}/mpd | cut -d= -f2)
	test $(code "$base/vod/shared/audio/init.mp4?token=$init") = 200
	test $(code "$base/vod/movie/audio/init.mp4?token=$init") = 403
	subs=$(grep -o 'subs/en[.]vtt?token=[^ ]*' ${tmpdir}/mpd | cut -d= -f2)
	test $(code "$base/vod/movie/subs/en.vtt?token=$subs") = 200

	token=$(get -f "$base/long/a/index.m3u8" | sed -n 's/^seg\.ts?token=//p')
	test $(( $(field "$token" 2) - $(date +%s) <= 10 * 365 * 24 * 3600 ))  = 1
	test $(code "$base/long/a/seg.ts?token=$token") = 200

	echo "flow ok"
}

logexpect l1 -v v1 -d 1 -g raw {
	expect * * Error "function 'authorize' is registered for riscv.call.., not as a transform"
	expect * * VCL_Error "'personalize' is a transform, use riscv.deliver_transform"
} -run

varnish v1 -expect backend_req == 14
