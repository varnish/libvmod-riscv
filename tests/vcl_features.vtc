varnishtest "VCL tenant: vmods, ACLs, digests, cache metadata"

server s1 {
	rxreq
	expect req.url == "/a"
	expect req.http.X-Local == "yes"
	expect req.http.X-Upper == "WORLD"
	expect req.http.X-Sha == "0xba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
	expect req.http.X-Mac == "0x2d93cbc1be167bcb1637a4a23cbff01a7878f0c50ee833954ea5221bb1b8c628"
	expect req.http.X-Mac-Ok == "yes"
	expect req.http.Cookie == "session=abc"
	expect req.http.X-Drop-One == <undef>
	expect req.http.X-Drop-Two == <undef>
	expect req.http.X-Keep == "kept"
	txresp -body "a"

	rxreq
	expect req.url == "/uncacheable"
	txresp -body "u1"

	rxreq
	expect req.url == "/uncacheable"
	txresp -body "u2"
} -start

varnish v1 -arg "-p workspace_client=128k" -arg "-p workspace_backend=128k" -vcl+backend {
	vcl 4.1;
	import riscv;

	sub vcl_init {
		riscv.embed_tenants("""{
			"test.com": {
				"filename": "${testdir}/vcl/features.vcl"
			}
		}""");
		riscv.finalize_tenants();
	}

	include "${testdir}/vcl_router.vcl";
} -start

client c1 {
	txreq -url "/a" -hdr "Host: test.com" -hdr "X-Name: world" \
		-hdr "Cookie: other=0; session=abc" \
		-hdr "X-Drop-One: 1" -hdr "X-Drop-Two: 2" -hdr "X-Keep: kept"
	rxresp
	expect resp.status == 200
	expect resp.body == "a"
	expect resp.http.X-Grace == "10.000"
	expect resp.http.X-Ttl == "120.000"
	expect resp.http.X-Visits == "1"
	expect resp.http.X-Status == "200"

	# beresp.uncacheable: the second request is fetched again.
	txreq -url "/uncacheable" -hdr "Host: test.com"
	rxresp
	expect resp.body == "u1"
	txreq -url "/uncacheable" -hdr "Host: test.com"
	rxresp
	expect resp.body == "u2"
} -run
