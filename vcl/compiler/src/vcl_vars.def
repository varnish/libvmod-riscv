// pattern, type, readable phases, writable phases, lowering, write constraint
//
// This file is deliberately data-only. Type checking, phase ownership tests,
// and lowering resolve through VARIABLES; an ABI surface addition has one row.
//
// The phase sets are Varnish Enterprise's (doc/sphinx/reference/vcl_var.rst),
// less what a tenant cannot reach: `client` is Phase::CLIENT and `backend` is
// Phase::BACKEND.
pub(crate) const FRAMING_HEADERS: &[&str] = &[
    "connection",
    "content-length",
    "keep-alive",
    "proxy-authenticate",
    "proxy-authorization",
    "te",
    "trailer",
    "transfer-encoding",
    "upgrade",
];

const NONE: &[Phase] = &[];
const HIT: &[Phase] = &[Phase::Hit];
const HIT_DELIVER: &[Phase] = &[Phase::Hit, Phase::Deliver];
const DELIVER: &[Phase] = &[Phase::Deliver];
const RESP: &[Phase] = &[Phase::Deliver, Phase::Synth];
const SYNTH: &[Phase] = &[Phase::Synth];
const BERESP: &[Phase] = &[Phase::BackendResponse, Phase::BackendError];
const BACKEND_ERROR: &[Phase] = &[Phase::BackendError];
const BOTH: &[Phase] = Phase::ALL;
const CLIENT: &[Phase] = Phase::CLIENT;
const BACKEND: &[Phase] = Phase::BACKEND;

pub(crate) const VARIABLES: &[VariableSpec] = &[
    VariableSpec {
        pattern: "now",
        value_type: ValueType::Time,
        readable: BOTH,
        writable: NONE,
        lowering: Lowering::Now,
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "client.ip",
        value_type: ValueType::Ip,
        readable: BOTH,
        writable: NONE,
        lowering: Lowering::ClientIp,
        write_constraint: WriteConstraint::None,
    },
    // Varnish spells the peer address three ways. `remote.ip` is the socket
    // peer and `client.identity` defaults to it. All three are the client
    // address here: there is no PROXY-protocol resolution behind them, and
    // `client.identity` is an IP rather than Varnish's STRING, which is what
    // "alias" means: it matches an acl and renders as an address in a string
    // context.
    VariableSpec {
        pattern: "remote.ip",
        value_type: ValueType::Ip,
        readable: BOTH,
        writable: NONE,
        lowering: Lowering::ClientIp,
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "client.identity",
        value_type: ValueType::Ip,
        readable: BOTH,
        writable: NONE,
        lowering: Lowering::ClientIp,
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "server.hostname",
        value_type: ValueType::String,
        readable: BOTH,
        writable: NONE,
        lowering: Lowering::Host(HostVar::ServerHostname),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "server.identity",
        value_type: ValueType::String,
        readable: BOTH,
        writable: NONE,
        lowering: Lowering::Host(HostVar::ServerIdentity),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "req.http.*",
        value_type: ValueType::String,
        readable: CLIENT,
        writable: CLIENT,
        lowering: Lowering::RequestHeader,
        write_constraint: WriteConstraint::ClientRequestHeader,
    },
    VariableSpec {
        pattern: "bereq.http.*",
        value_type: ValueType::String,
        readable: BACKEND,
        writable: BACKEND,
        lowering: Lowering::RequestHeader,
        write_constraint: WriteConstraint::Header,
    },
    VariableSpec {
        pattern: "beresp.http.*",
        value_type: ValueType::String,
        readable: BERESP,
        writable: BERESP,
        lowering: Lowering::ResponseHeader,
        write_constraint: WriteConstraint::Header,
    },
    VariableSpec {
        pattern: "resp.http.*",
        value_type: ValueType::String,
        readable: RESP,
        writable: RESP,
        lowering: Lowering::ResponseHeader,
        write_constraint: WriteConstraint::Header,
    },
    VariableSpec {
        pattern: "req.url",
        value_type: ValueType::String,
        readable: CLIENT,
        writable: CLIENT,
        lowering: Lowering::RequestUrl,
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "bereq.url",
        value_type: ValueType::String,
        readable: BACKEND,
        writable: BACKEND,
        lowering: Lowering::RequestUrl,
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "req.method",
        value_type: ValueType::String,
        readable: CLIENT,
        writable: CLIENT,
        lowering: Lowering::RequestMethod,
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "bereq.method",
        value_type: ValueType::String,
        readable: BACKEND,
        writable: BACKEND,
        lowering: Lowering::RequestMethod,
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "req.proto",
        value_type: ValueType::String,
        readable: CLIENT,
        writable: NONE,
        lowering: Lowering::Host(HostVar::RequestProto),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "bereq.proto",
        value_type: ValueType::String,
        readable: BACKEND,
        writable: NONE,
        lowering: Lowering::Host(HostVar::RequestProto),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "req.xid",
        value_type: ValueType::String,
        readable: CLIENT,
        writable: NONE,
        lowering: Lowering::Host(HostVar::Xid),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "bereq.xid",
        value_type: ValueType::String,
        readable: BACKEND,
        writable: NONE,
        lowering: Lowering::Host(HostVar::Xid),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "req.restarts",
        value_type: ValueType::Integer,
        readable: CLIENT,
        writable: NONE,
        lowering: Lowering::Host(HostVar::Restarts),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "req.esi_level",
        value_type: ValueType::Integer,
        readable: CLIENT,
        writable: NONE,
        lowering: Lowering::Host(HostVar::EsiLevel),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "req.can_gzip",
        value_type: ValueType::Boolean,
        readable: CLIENT,
        writable: NONE,
        lowering: Lowering::Host(HostVar::CanGzip),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "req.hash_always_miss",
        value_type: ValueType::Boolean,
        readable: CLIENT,
        writable: CLIENT,
        lowering: Lowering::Host(HostVar::HashAlwaysMiss),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "req.hash_ignore_busy",
        value_type: ValueType::Boolean,
        readable: CLIENT,
        writable: CLIENT,
        lowering: Lowering::Host(HostVar::HashIgnoreBusy),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "bereq.retries",
        value_type: ValueType::Integer,
        readable: BACKEND,
        writable: NONE,
        lowering: Lowering::Host(HostVar::BereqRetries),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "bereq.uncacheable",
        value_type: ValueType::Boolean,
        readable: BACKEND,
        writable: NONE,
        lowering: Lowering::Host(HostVar::BereqUncacheable),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "bereq.is_bgfetch",
        value_type: ValueType::Boolean,
        readable: BACKEND,
        writable: NONE,
        lowering: Lowering::Host(HostVar::BereqIsBgfetch),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "beresp.proto",
        value_type: ValueType::String,
        readable: BERESP,
        writable: NONE,
        lowering: Lowering::Host(HostVar::ResponseProto),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "beresp.status",
        value_type: ValueType::Integer,
        readable: BERESP,
        writable: BERESP,
        lowering: Lowering::Host(HostVar::BerespStatus),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "beresp.reason",
        value_type: ValueType::String,
        readable: BERESP,
        writable: BERESP,
        lowering: Lowering::Host(HostVar::BerespReason),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "beresp.ttl",
        value_type: ValueType::Duration,
        readable: BERESP,
        writable: BERESP,
        lowering: Lowering::Ttl,
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "beresp.grace",
        value_type: ValueType::Duration,
        readable: BERESP,
        writable: BERESP,
        lowering: Lowering::StaleWhileRevalidate,
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "beresp.keep",
        value_type: ValueType::Duration,
        readable: BERESP,
        writable: BERESP,
        lowering: Lowering::StaleIfError,
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "beresp.age",
        value_type: ValueType::Duration,
        readable: BERESP,
        writable: NONE,
        lowering: Lowering::Host(HostVar::BerespAge),
        write_constraint: WriteConstraint::None,
    },
    // Varnish ignores (and logs) a write of false after true, so only the
    // write that does something is accepted.
    VariableSpec {
        pattern: "beresp.uncacheable",
        value_type: ValueType::Boolean,
        readable: BERESP,
        writable: BERESP,
        lowering: Lowering::Uncacheable,
        write_constraint: WriteConstraint::TrueOnly,
    },
    VariableSpec {
        pattern: "beresp.do_stream",
        value_type: ValueType::Boolean,
        readable: BERESP,
        writable: BERESP,
        lowering: Lowering::Host(HostVar::BerespDoStream),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "beresp.do_gzip",
        value_type: ValueType::Boolean,
        readable: BERESP,
        writable: BERESP,
        lowering: Lowering::Host(HostVar::BerespDoGzip),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "beresp.do_gunzip",
        value_type: ValueType::Boolean,
        readable: BERESP,
        writable: BERESP,
        lowering: Lowering::Host(HostVar::BerespDoGunzip),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "beresp.body",
        value_type: ValueType::String,
        readable: NONE,
        writable: BACKEND_ERROR,
        lowering: Lowering::Body,
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "obj.proto",
        value_type: ValueType::String,
        readable: HIT,
        writable: NONE,
        lowering: Lowering::Host(HostVar::ObjProto),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "obj.status",
        value_type: ValueType::Integer,
        readable: HIT,
        writable: NONE,
        lowering: Lowering::Host(HostVar::ObjStatus),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "obj.reason",
        value_type: ValueType::String,
        readable: HIT,
        writable: NONE,
        lowering: Lowering::Host(HostVar::ObjReason),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "obj.hits",
        value_type: ValueType::Integer,
        readable: HIT_DELIVER,
        writable: NONE,
        lowering: Lowering::Host(HostVar::ObjHits),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "obj.ttl",
        value_type: ValueType::Duration,
        readable: HIT_DELIVER,
        writable: NONE,
        lowering: Lowering::Host(HostVar::ObjTtl),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "obj.grace",
        value_type: ValueType::Duration,
        readable: HIT_DELIVER,
        writable: NONE,
        lowering: Lowering::Host(HostVar::ObjGrace),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "obj.keep",
        value_type: ValueType::Duration,
        readable: HIT_DELIVER,
        writable: NONE,
        lowering: Lowering::Host(HostVar::ObjKeep),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "obj.age",
        value_type: ValueType::Duration,
        readable: HIT_DELIVER,
        writable: NONE,
        lowering: Lowering::Host(HostVar::ObjAge),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "obj.uncacheable",
        value_type: ValueType::Boolean,
        readable: DELIVER,
        writable: NONE,
        lowering: Lowering::Host(HostVar::ObjUncacheable),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "resp.proto",
        value_type: ValueType::String,
        readable: RESP,
        writable: NONE,
        lowering: Lowering::Host(HostVar::ResponseProto),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "resp.status",
        value_type: ValueType::Integer,
        readable: RESP,
        writable: RESP,
        lowering: Lowering::Host(HostVar::RespStatus),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "resp.reason",
        value_type: ValueType::String,
        readable: RESP,
        writable: RESP,
        lowering: Lowering::Host(HostVar::RespReason),
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "resp.body",
        value_type: ValueType::String,
        readable: NONE,
        writable: SYNTH,
        lowering: Lowering::Body,
        write_constraint: WriteConstraint::None,
    },
    // Not Varnish's: whether the delivered response came out of the cache
    // without waiting on the origin (a hit, or a grace hit).
    VariableSpec {
        pattern: "req.cache_hit",
        value_type: ValueType::Boolean,
        readable: DELIVER,
        writable: NONE,
        lowering: Lowering::CacheHit,
        write_constraint: WriteConstraint::None,
    },
];
